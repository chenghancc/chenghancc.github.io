---
import { SITE } from "@data/site";

const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--border)] bg-[var(--bg)]/70">
	<div class="mx-auto flex max-w-5xl flex-col items-start justify-between gap-4 px-5 py-8 text-xs text-[var(--fg-muted)] sm:flex-row sm:items-center sm:px-8">
		<div class="flex flex-wrap items-center gap-x-3 gap-y-1">
			<span class="font-mono text-[var(--fg-secondary)]">© {year} {SITE.author}</span>
			<span aria-hidden="true">·</span>
			<span>Built with Astro &amp; AI</span>
		</div>

		<div class="flex items-center gap-4">
			<a href="/posts/" class="transition-colors hover:text-[var(--fg)]">归档</a>
			<a href="/projects/" class="transition-colors hover:text-[var(--fg)]">项目</a>
			<a href="/rss.xml" class="transition-colors hover:text-[var(--fg)]">RSS</a>
			<a
				href={SITE.github}
				target="_blank"
				rel="noopener noreferrer"
				class="transition-colors hover:text-[var(--fg)]"
			>
				GitHub
			</a>
		</div>
	</div>
</footer>
