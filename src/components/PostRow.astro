---
import { type BlogPost, formatDate } from "@utils/posts";

interface Props {
	post: BlogPost;
	minutes?: number;
}

const { post, minutes } = Astro.props;
const { title, description, published, category, tags } = post.data;
---

<article class="group">
	<a
		href={`/posts/${post.slug}/`}
		class="surface-card flex flex-col gap-3 rounded-2xl p-5 sm:flex-row sm:items-start sm:justify-between sm:gap-6"
	>
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2 font-mono text-xs text-[var(--fg-muted)]">
				<time datetime={published.toISOString()}>{formatDate(published)}</time>
				{category && (
					<>
						<span aria-hidden="true">/</span>
						<span class="rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] px-2 py-0.5 text-[11px] text-[var(--fg-secondary)]">
							{category}
						</span>
					</>
				)}
				{minutes && (
					<>
						<span aria-hidden="true">·</span>
						<span>{minutes} min read</span>
					</>
				)}
			</div>

			<h3 class="mt-2 text-base font-semibold tracking-tight text-[var(--fg)] transition-colors group-hover:text-[var(--accent)] sm:text-lg">
				{title}
			</h3>

			{description && (
				<p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-[var(--fg-secondary)]">
					{description}
				</p>
			)}

			{tags.length > 0 && (
				<div class="mt-3 flex flex-wrap gap-1.5">
					{tags.map((tag) => (
						<span class="font-mono text-[11px] text-[var(--fg-muted)]">#{tag}</span>
					))}
				</div>
			)}
		</div>

		<span
			class="hidden shrink-0 self-center rounded-lg border border-[var(--border)] p-2 text-[var(--fg-muted)] transition-all duration-200 group-hover:translate-x-0.5 group-hover:border-[var(--border-strong)] group-hover:text-[var(--fg)] sm:inline-flex"
			aria-hidden="true"
		>
			<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
				<path d="M5 12h14" />
				<path d="m12 5 7 7-7 7" />
			</svg>
		</span>
	</a>
</article>
