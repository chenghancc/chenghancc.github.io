---
import { SITE } from "@data/site";

const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
	if (href === "/") return pathname === "/";
	return pathname.startsWith(href);
}
---

<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/80 backdrop-blur-md">
	<div class="mx-auto flex h-16 max-w-5xl items-center justify-between px-5 sm:px-8">
		<a
			href="/"
			class="group flex items-center gap-2.5 text-sm font-semibold tracking-tight text-[var(--fg)]"
		>
			<span
				class="flex h-7 w-7 items-center justify-center rounded-lg border border-[var(--border-strong)] bg-[var(--bg-elevated)] font-mono text-xs font-bold tracking-tighter text-[var(--fg)] transition-colors group-hover:border-[var(--accent)] group-hover:text-[var(--accent)]"
			>
				cc
			</span>
			<span>{SITE.title}</span>
		</a>

		<nav class="hidden items-center gap-1 md:flex" aria-label="主导航">
			{SITE.nav.map((item) => {
				const active = isActive(item.href);
				return (
					<a
						href={item.href}
						class:list={[
							"rounded-lg px-3 py-1.5 text-sm transition-colors",
							active
								? "bg-[var(--bg-subtle)] font-medium text-[var(--fg)]"
								: "text-[var(--fg-secondary)] hover:bg-[var(--bg-subtle)]/60 hover:text-[var(--fg)]",
						]}
					>
						{item.label}
					</a>
				);
			})}
		</nav>

		<div class="flex items-center gap-2">
			<button
				type="button"
				id="cmd-open-btn"
				class="flex h-8 items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] px-2.5 text-xs text-[var(--fg-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--fg)]"
				aria-label="打开命令搜索面板"
			>
				<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8" />
					<path d="m21 21-4.3-4.3" />
				</svg>
				<span class="hidden sm:inline">搜索</span>
				<kbd class="hidden rounded border border-[var(--border)] bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--fg-muted)] sm:inline">
					⌘K
				</kbd>
			</button>

			<button
				type="button"
				id="theme-toggle"
				class="flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--fg-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--fg)]"
				aria-label="切换深浅主题"
				title="切换深浅主题"
			>
				<svg class="hidden h-4 w-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2" />
					<path d="M12 20v2" />
					<path d="m4.93 4.93 1.41 1.41" />
					<path d="m17.66 17.66 1.41 1.41" />
					<path d="M2 12h2" />
					<path d="M20 12h2" />
					<path d="m6.34 17.66-1.41 1.41" />
					<path d="m19.07 4.93-1.41 1.41" />
				</svg>
				<svg class="block h-4 w-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z" />
				</svg>
			</button>

			<a
				href={SITE.github}
				target="_blank"
				rel="noopener noreferrer"
				class="hidden h-8 w-8 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--fg-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--fg)] sm:flex"
				aria-label="GitHub"
				title="GitHub"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.88-1.36-3.88-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.19-1.49 3.16-1.18 3.16-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.08 0 4.41-2.69 5.39-5.25 5.67.41.36.78 1.06.78 2.14 0 1.55-.01 2.79-.01 3.17 0 .31.21.66.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z" />
				</svg>
			</a>

			<button
				type="button"
				id="mobile-menu-btn"
				class="flex h-8 w-8 items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg-elevated)] text-[var(--fg-secondary)] md:hidden"
				aria-label="切换导航菜单"
				aria-expanded="false"
			>
				<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<line x1="4" x2="20" y1="7" y2="7" />
					<line x1="4" x2="20" y1="12" y2="12" />
					<line x1="4" x2="20" y1="17" y2="17" />
				</svg>
			</button>
		</div>
	</div>

	<div id="mobile-menu" class="hidden border-t border-[var(--border)] bg-[var(--bg)] px-5 py-3 md:hidden">
		<div class="flex flex-col gap-1">
			{SITE.nav.map((item) => {
				const active = isActive(item.href);
				return (
					<a
						href={item.href}
						class:list={[
							"rounded-lg px-3 py-2 text-sm transition-colors",
							active
								? "bg-[var(--bg-subtle)] font-medium text-[var(--fg)]"
								: "text-[var(--fg-secondary)] hover:bg-[var(--bg-subtle)] hover:text-[var(--fg)]",
						]}
					>
						{item.label}
					</a>
				);
			})}
		</div>
	</div>
</header>

<script is:inline>
	(() => {
		const toggleBtn = document.getElementById("theme-toggle");
		const mobileBtn = document.getElementById("mobile-menu-btn");
		const mobileMenu = document.getElementById("mobile-menu");

		function applyTheme(next) {
			document.documentElement.classList.toggle("dark", next === "dark");
			localStorage.setItem("theme", next);
		}

		window.__toggleTheme = () => {
			const isDark = document.documentElement.classList.contains("dark");
			applyTheme(isDark ? "light" : "dark");
		};

		toggleBtn?.addEventListener("click", () => {
			window.__toggleTheme?.();
		});

		mobileBtn?.addEventListener("click", () => {
			if (!mobileMenu) return;
			const isHidden = mobileMenu.classList.toggle("hidden");
			mobileBtn.setAttribute("aria-expanded", String(!isHidden));
		});
	})();
</script>
