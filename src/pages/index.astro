---
import ActivityHeatmap from "@components/ActivityHeatmap.astro";
import PostRow from "@components/PostRow.astro";
import ProjectCard from "@components/ProjectCard.astro";
import { PROJECTS, SITE } from "@data/site";
import BaseLayout from "@layouts/BaseLayout.astro";
import { getPublishedPosts } from "@utils/posts";

const allPosts = await getPublishedPosts();
const recentPosts = await Promise.all(
	allPosts.slice(0, 6).map(async (post) => {
		const { remarkPluginFrontmatter } = await post.render();
		return {
			post,
			minutes: remarkPluginFrontmatter.minutes as number | undefined,
		};
	}),
);

const featuredProjects = PROJECTS.filter((p) => p.featured !== false).slice(
	0,
	3,
);
---

<BaseLayout>
	<!-- Hero Section -->
	<section class="grid items-start gap-8 pb-16 pt-2 lg:grid-cols-12 lg:gap-10 lg:pb-20">
		<div class="lg:col-span-7">
			<div class="inline-flex items-center gap-2.5 rounded-full border border-[var(--border)] bg-[var(--bg-elevated)] px-3.5 py-1.5 text-xs text-[var(--fg-secondary)]">
				<span class="pulse-dot relative inline-flex h-2 w-2 rounded-full bg-emerald-500 text-emerald-500" aria-hidden="true" />
				<span class="font-mono">{SITE.statusBadge}</span>
			</div>

			<h1 class="mt-6 text-3xl font-bold tracking-tight text-[var(--fg)] sm:text-5xl sm:leading-[1.15]">
				Hi, I&apos;m{" "}
				<span class="bg-gradient-to-r from-sky-600 via-indigo-600 to-cyan-600 bg-clip-text text-transparent dark:from-sky-400 dark:via-indigo-400 dark:to-cyan-300">
					{SITE.title}
				</span>
				<span class="mt-2 block text-2xl font-semibold text-[var(--fg-secondary)] sm:text-3xl">
					{SITE.heroHeadline}
				</span>
			</h1>

			<p class="mt-5 max-w-xl text-base leading-relaxed text-[var(--fg-secondary)]">
				{SITE.heroBio}
			</p>

			<div class="mt-8 flex flex-wrap items-center gap-3">
				<a
					href="/posts/"
					class="inline-flex items-center gap-2 rounded-xl bg-[var(--fg)] px-4 py-2.5 text-sm font-medium text-[var(--bg)] transition-opacity hover:opacity-90"
				>
					<span>阅读文章</span>
					<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M5 12h14" />
						<path d="m12 5 7 7-7 7" />
					</svg>
				</a>

				<a
					href="/projects/"
					class="inline-flex items-center gap-2 rounded-xl border border-[var(--border-strong)] bg-[var(--bg-elevated)] px-4 py-2.5 text-sm font-medium text-[var(--fg)] transition-colors hover:bg-[var(--bg-subtle)]"
				>
					<span>浏览项目</span>
				</a>

				<a
					href={SITE.github}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center gap-1.5 rounded-xl px-3 py-2.5 text-sm text-[var(--fg-secondary)] transition-colors hover:text-[var(--fg)]"
				>
					<span>GitHub</span>
					<svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M7 17 17 7" />
						<path d="M7 7h10v10" />
					</svg>
				</a>
			</div>

			<p class="mt-5 font-mono text-xs text-[var(--fg-muted)]">
				Tip: 按 <kbd class="rounded border border-[var(--border)] bg-[var(--bg-subtle)] px-1.5 py-0.5 text-[11px]">⌘K</kbd> 或 <kbd class="rounded border border-[var(--border)] bg-[var(--bg-subtle)] px-1.5 py-0.5 text-[11px]">Ctrl+K</kbd> 随时唤起全站搜索与快捷命令
			</p>
		</div>

		<!-- Identity Bento Card -->
		<aside class="surface-card rounded-2xl p-5 lg:col-span-5">
			<div class="flex items-center gap-3.5 border-b border-[var(--border)] pb-4">
				<img
					src={SITE.avatar}
					alt={SITE.author}
					width="48"
					height="48"
					loading="eager"
					class="h-12 w-12 rounded-xl border border-[var(--border)] object-cover"
				/>
				<div class="min-w-0">
					<div class="flex items-center gap-2">
						<span class="font-semibold text-[var(--fg)]">{SITE.author}</span>
						<span class="rounded border border-[var(--border)] bg-[var(--bg-subtle)] px-1.5 py-0.5 font-mono text-[10px] text-[var(--fg-muted)]">
							v2.0
						</span>
					</div>
					<p class="truncate font-mono text-xs text-[var(--fg-muted)]">
						chenghancc.github.io
					</p>
				</div>
			</div>

			<dl class="mt-4 space-y-2.5 font-mono text-xs">
				{SITE.focusStack.map((item) => (
					<div class="flex items-baseline justify-between gap-4">
						<dt class="shrink-0 text-[var(--fg-muted)]">{item.label}</dt>
						<dd class="truncate text-right text-[var(--fg-secondary)]">{item.value}</dd>
					</div>
				))}
			</dl>

			<div class="mt-5 grid grid-cols-2 gap-2.5 border-t border-[var(--border)] pt-4">
				<a
					href="/posts/"
					class="rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]/60 p-3 transition-colors hover:border-[var(--border-strong)]"
				>
					<div class="font-mono text-lg font-semibold text-[var(--fg)]">{allPosts.length}</div>
					<div class="text-xs text-[var(--fg-muted)]">已发布文章</div>
				</a>
				<a
					href="/projects/"
					class="rounded-xl border border-[var(--border)] bg-[var(--bg-subtle)]/60 p-3 transition-colors hover:border-[var(--border-strong)]"
				>
					<div class="font-mono text-lg font-semibold text-[var(--fg)]">{PROJECTS.length}</div>
					<div class="text-xs text-[var(--fg-muted)]">项目与实验</div>
				</a>
			</div>
		</aside>
	</section>

	<!-- Activity Heatmap -->
	<ActivityHeatmap />

	<!-- Featured Projects -->
	<section class="border-t border-[var(--border)] py-14">
		<div class="flex items-end justify-between gap-4">
			<div>
				<p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)]">Projects</p>
				<h2 class="mt-1 text-xl font-semibold tracking-tight text-[var(--fg)] sm:text-2xl">
					精选项目与 AI 实践
				</h2>
			</div>
			<a
				href="/projects/"
				class="inline-flex items-center gap-1 font-mono text-xs text-[var(--fg-secondary)] transition-colors hover:text-[var(--fg)]"
			>
				<span>全部项目</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>

		<div class="mt-6 grid gap-4 md:grid-cols-3">
			{featuredProjects.map((project) => (
				<ProjectCard project={project} />
			))}
		</div>
	</section>

	<!-- Latest Posts -->
	<section class="border-t border-[var(--border)] pt-14">
		<div class="flex items-end justify-between gap-4">
			<div>
				<p class="font-mono text-xs uppercase tracking-wider text-[var(--accent)]">Writing</p>
				<h2 class="mt-1 text-xl font-semibold tracking-tight text-[var(--fg)] sm:text-2xl">
					最新文章
				</h2>
			</div>
			<a
				href="/posts/"
				class="inline-flex items-center gap-1 font-mono text-xs text-[var(--fg-secondary)] transition-colors hover:text-[var(--fg)]"
			>
				<span>全部归档</span>
				<span aria-hidden="true">→</span>
			</a>
		</div>

		<div class="mt-6 space-y-3">
			{recentPosts.map(({ post, minutes }) => (
				<PostRow post={post} minutes={minutes} />
			))}
		</div>
	</section>
</BaseLayout>
