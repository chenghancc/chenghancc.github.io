---
import BaseLayout from "@layouts/BaseLayout.astro";
import { formatDate, getPublishedPosts } from "@utils/posts";

export async function getStaticPaths() {
	const posts = await getPublishedPosts();
	return posts.map((post, index) => ({
		params: { slug: post.slug },
		props: {
			post,
			prevPost: index < posts.length - 1 ? posts[index + 1] : null,
			nextPost: index > 0 ? posts[index - 1] : null,
		},
	}));
}

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await post.render();
const tocHeadings = headings
	.filter((h) => h.depth >= 2 && h.depth <= 3)
	.map((h) => ({
		...h,
		text: h.text.replace(/#$/, "").trim(),
	}));
const minutes = remarkPluginFrontmatter.minutes as number | undefined;
const words = remarkPluginFrontmatter.words as number | undefined;
---

<BaseLayout
	title={post.data.title}
	description={post.data.description || post.data.title}
	ogType="article"
	publishedTime={post.data.published.toISOString()}
	showGlow={false}
>
	<div class="mx-auto max-w-5xl">
		<!-- Breadcrumb -->
		<nav class="mb-6 flex items-center gap-2 font-mono text-xs text-[var(--fg-muted)]" aria-label="面包屑导航">
			<a href="/" class="transition-colors hover:text-[var(--fg)]">首页</a>
			<span aria-hidden="true">/</span>
			<a href="/posts/" class="transition-colors hover:text-[var(--fg)]">文章</a>
			{post.data.category && (
				<>
					<span aria-hidden="true">/</span>
					<a
						href={`/posts/?category=${encodeURIComponent(post.data.category)}`}
						class="transition-colors hover:text-[var(--fg)]"
					>
						{post.data.category}
					</a>
				</>
			)}
		</nav>

		<div class="grid gap-10 lg:grid-cols-12">
			<!-- Main Article -->
			<article class="min-w-0 lg:col-span-9">
				<header class="border-b border-[var(--border)] pb-8">
					<h1 class="text-2xl font-bold tracking-tight text-[var(--fg)] sm:text-4xl sm:leading-[1.2]">
						{post.data.title}
					</h1>

					{post.data.description && (
						<p class="mt-4 text-base leading-relaxed text-[var(--fg-secondary)]">
							{post.data.description}
						</p>
					)}

					<div class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-[var(--fg-muted)]">
						<time datetime={post.data.published.toISOString()}>
							发布于 {formatDate(post.data.published)}
						</time>
						{post.data.updated && (
							<time datetime={post.data.updated.toISOString()}>
								更新于 {formatDate(post.data.updated)}
							</time>
						)}
						{minutes && <span>约 {minutes} 分钟阅读</span>}
						{words && <span>{words} 词</span>}
					</div>

					{post.data.tags.length > 0 && (
						<div class="mt-4 flex flex-wrap gap-2">
							{post.data.tags.map((tag) => (
								<a
									href={`/posts/?tag=${encodeURIComponent(tag)}`}
									class="rounded-md border border-[var(--border)] bg-[var(--bg-subtle)] px-2 py-0.5 font-mono text-[11px] text-[var(--fg-secondary)] transition-colors hover:border-[var(--border-strong)] hover:text-[var(--fg)]"
								>
									#{tag}
								</a>
							))}
						</div>
					)}
				</header>

				<div class="article-prose mt-8">
					<Content />
				</div>

				<!-- Prev / Next Navigation -->
				<nav class="mt-14 grid gap-3 border-t border-[var(--border)] pt-8 sm:grid-cols-2" aria-label="文章翻页">
					{nextPost ? (
						<a
							href={`/posts/${nextPost.slug}/`}
							class="surface-card group rounded-2xl p-4"
						>
							<div class="font-mono text-[11px] text-[var(--fg-muted)]">← 较新一篇</div>
							<div class="mt-1 truncate text-sm font-medium text-[var(--fg)] transition-colors group-hover:text-[var(--accent)]">
								{nextPost.data.title}
							</div>
						</a>
					) : (
						<div />
					)}

					{prevPost && (
						<a
							href={`/posts/${prevPost.slug}/`}
							class="surface-card group rounded-2xl p-4 sm:text-right"
						>
							<div class="font-mono text-[11px] text-[var(--fg-muted)]">较早一篇 →</div>
							<div class="mt-1 truncate text-sm font-medium text-[var(--fg)] transition-colors group-hover:text-[var(--accent)]">
								{prevPost.data.title}
							</div>
						</a>
					)}
				</nav>
			</article>

			<!-- Sticky TOC -->
			<aside class="hidden lg:col-span-3 lg:block">
				<div class="sticky top-24">
					{tocHeadings.length > 0 && (
						<div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-elevated)]/70 p-4">
							<p class="font-mono text-[11px] uppercase tracking-wider text-[var(--fg-muted)]">
								On this page
							</p>
							<ul id="toc-list" class="mt-3 space-y-2 text-xs">
								{tocHeadings.map((h) => (
									<li class={h.depth === 3 ? "pl-3" : ""}>
										<a
											href={`#${h.slug}`}
											data-toc-link={h.slug}
											class="toc-link block truncate text-[var(--fg-secondary)] transition-colors hover:text-[var(--fg)]"
										>
											{h.text}
										</a>
									</li>
								))}
							</ul>
						</div>
					)}

					<button
						type="button"
						id="back-to-top-btn"
						class="mt-4 inline-flex items-center gap-1.5 font-mono text-xs text-[var(--fg-muted)] transition-colors hover:text-[var(--fg)]"
					>
						<span>↑ 返回顶部</span>
					</button>
				</div>
			</aside>
		</div>
	</div>
</BaseLayout>

<script is:inline>
	(() => {
		const backBtn = document.getElementById("back-to-top-btn");
		backBtn?.addEventListener("click", () => {
			window.scrollTo({ top: 0, behavior: "smooth" });
		});

		const links = Array.from(document.querySelectorAll("[data-toc-link]"));
		if (links.length === 0) return;

		const headings = links
			.map((l) => document.getElementById(l.getAttribute("data-toc-link") || ""))
			.filter(Boolean);

		const observer = new IntersectionObserver(
			(entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						const id = entry.target.id;
						for (const link of links) {
							const active = link.getAttribute("data-toc-link") === id;
							link.classList.toggle("text-[var(--accent)]", active);
							link.classList.toggle("font-medium", active);
							link.classList.toggle("text-[var(--fg-secondary)]", !active);
						}
					}
				}
			},
			{ rootMargin: "-80px 0px -70% 0px" },
		);

		for (const h of headings) observer.observe(h);
	})();
</script>
